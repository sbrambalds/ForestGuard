MAS forestGuard {

	infrastructure: Centralised

	environment: env.ForestEnvironment()

	agents:
		scout1 scout_agent agentClass agent.ScoutAgent;
		scout2 scout_agent agentClass agent.ScoutAgent;
		scout3 scout_agent agentClass agent.ScoutAgent;
		scout4 scout_agent agentClass agent.ScoutAgent;
		station station_agent agentClass agent.StationAgent;
		firefighter1 firefighter_agent agentClass agent.FFAgent;
		firefighter2 firefighter_agent agentClass agent.FFAgent;
		firefighter3 firefighter_agent agentClass agent.FFAgent;
		firefighter4 firefighter_agent agentClass agent.FFAgent;

	aslSourcePath:
		"src/main/asl";
}